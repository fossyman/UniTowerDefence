[sub_resource type="GDScript" id="GDScript_1d4ga"]
script/source = "extends RichTextLabel
@export var Sidebar_left:Control
@export var Sidebar_right:Control
@export var Sidebar_Middle:Control
func _ready():
	connect(\"meta_clicked\", meta_clicked)
	get_v_scroll_bar().connect(\"value_changed\",Scroll)
	
func meta_clicked(meta):
	OS.shell_open(meta)

func Scroll(_value:float):
	Sidebar_left.position.y = -_value
	Sidebar_right.position.y = -_value
	Sidebar_Middle.position.y = -_value
	pass
"

