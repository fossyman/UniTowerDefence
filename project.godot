; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Our Kingdom's Last Stand"
run/main_scene="uid://3pu1ralxgg5i"
config/features=PackedStringArray("4.4", "Mobile")
run/max_fps=60
config/icon="uid://dll8kn3gbc5m5"
config/windows_native_icon="res://assets/Textures/Icon.ico"

[autoload]

GLOBALS="*res://scripts/SCR_GLOBAL.gd"
AUDIOMANAGER="*res://scripts/SCR_AudioManager.gd"
NOTIFICATIONMANAGER="*res://scripts/SCR_NotificationManager.gd"
SAVELOADMANAGER="*res://scripts/SCR_SaveLoadManager.gd"
MUSICMANAGER="*res://scripts/SCR_MusicManager.gd"

[compression]

formats/zlib/compression_level=2
formats/gzip/compression_level=2

[debug_draw_3d]

settings/addon_root_folder="res://addons/debug_draw_3d"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[filesystem]

import/fbx2gltf/enabled=false
import/blender/enabled=false

